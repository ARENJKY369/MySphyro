NODE_ENV=development
API_PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side service-role key only. Never expose this in browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# Used only by the isolated automated test adapter, not by Supabase production storage.
DATABASE_PATH=./data/mysphyro.db
JWT_SECRET=development-only-local-test-secret
JWT_EXPIRES_IN=7d
